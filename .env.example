# SoFi Stadium Copilot — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Google Cloud ───────────────────────────────────────────
# Your GCP project ID (used for Firestore + Cloud Run)
GCP_PROJECT_ID=your-gcp-project-id

# ── Gemini AI ──────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── Google Cloud API (TTS) ─────────────────────────────────
# Used for Cloud Text-to-Speech in the fan portal.
# Leave blank to disable TTS (graceful fallback).
GOOGLE_CLOUD_API_KEY=

# ── Server ─────────────────────────────────────────────────
# Port the Express server listens on (Cloud Run uses 8080)
PORT=8080

# Comma-separated allowed CORS origins
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Firebase Hosting (optional) ───────────────────────────
# Used if deploying the React client to Firebase Hosting
FIREBASE_PROJECT_ID=your-firebase-project-id
